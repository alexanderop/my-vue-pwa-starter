{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client",
      "vite-plugin-pwa/client",
      "node",
      "@histoire/plugin-vue/components"
    ],
    "paths": { "@starter/ui": ["./packages/ui/src/index.ts"] }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.vue",
    "packages/**/*.ts",
    "packages/**/*.vue",
    "*.config.ts",
    "e2e/**/*.ts",
    "architecture/**/*.ts"
  ],
  "exclude": ["node_modules", "**/dist", "**/.histoire", "**/.histoire-dist"]
}
