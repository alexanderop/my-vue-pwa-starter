{
  "name": "my-vue-pwa-starter",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @starter/playground dev",
    "dev:ui": "pnpm --filter @starter/ui dev",
    "build": "pnpm build:app && pnpm build:ui",
    "build:app": "pnpm --filter @starter/playground build",
    "build:ui": "pnpm --filter @starter/ui build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --report-unused-disable-directives-severity=error apps packages scripts && eslint . && pnpm check:architecture",
    "check:architecture": "node scripts/test-architecture.mjs && node scripts/check-architecture.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:e2e": "bddgen && playwright test",
    "test": "pnpm test:unit && pnpm test:browser && pnpm test:e2e"
  },
  "devDependencies": {
    "@histoire/plugin-vue": "1.0.0-beta.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@typescript-eslint/parser": "8.71.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/browser-playwright": "5.0.3",
    "@vue/compiler-sfc": "3.5.43",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "histoire": "1.0.0-beta.1",
    "oxlint": "1.87.0",
    "playwright-bdd": "9.2.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3",
    "vitest-browser-vue": "3.1.0",
    "vue": "3.5.43",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.12"
  }
}
